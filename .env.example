# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-key-996
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,.run.app

# ==========================================================
# Dummy Ports Configuration (Assign real ports later)
# ==========================================================
PORT=3000
DJANGO_DEV_PORT=8000
ADMIN_PORT=8001
API_PORT=8002
DB_PORT=5432
REDIS_PORT=6379
EMAIL_PORT=587
PAYMENT_WEBHOOK_PORT=8081
COURIER_WEBHOOK_PORT=8082
WORKER_PORT=8083

# Database (Neon PostgreSQL or local SQLite fallback)
DATABASE_URL=postgres://user:password@ep-sample.region.aws.neon.tech:5432/dbname?sslmode=require

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# PhonePe Payment Gateway (Sandbox/Production)
PHONEPE_MERCHANT_ID=your_merchant_id
PHONEPE_SALT_KEY=your_salt_key
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox

# Redis Cache
REDIS_URL=redis://red-sample:6379

# Email Provider
EMAIL_HOST=smtp.sendgrid.net
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_key
DEFAULT_FROM_EMAIL=support@luxejewels.in
